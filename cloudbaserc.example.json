{
  "envId": "替换为你的-环境ID",
  "region": "ap-shanghai",
  "functionRoot": "./cloudbase/functions",
  "functions": [
    {
      "name": "summer-pet-family",
      "dir": "./cloudbase/functions/summer-pet-family",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "envVariables": {
        "SUMMER_PET_STORAGE": "postgresql",
        "SUMMER_PET_ROOT_DEVICE_ID": ""
      }
    }
  ]
}
