# CloudBase Publishable Key is designed for browser use. Never put a SecretId,
# SecretKey, server API key or Tencent account password in VITE_* variables.
VITE_CLOUDBASE_ENV_ID=summer-pet-family-xxxxxxxx
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=your_publishable_key
VITE_CLOUDBASE_FUNCTION_NAME=summer-pet-family
